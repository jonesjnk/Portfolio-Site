{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["typed-router.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "types": ["vite/client"],
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
